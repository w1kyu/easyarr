{
  "name": "easyarr",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./dashboard/*\" dev",
    "lint": "eslint . && prettier --check . && node scripts/check-vendor.mjs",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "build": "pnpm -r build",
    "check:vendor": "node scripts/check-vendor.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
