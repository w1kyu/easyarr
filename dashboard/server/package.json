{
  "name": "@easyarr/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Fastify API, wiring engine, backups, diagnostics, reverse proxy and init command.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@easyarr/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "EASYARR_STATE_DIR=../../dev/data/dashboard-state EASYARR_LICENSES_DIR=../.. EASYARR_WEB_DIR=../web/dist tsx watch --conditions=@easyarr/source src/index.ts serve",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@easyarr/shared": "workspace:*",
    "@fastify/helmet": "^13.2.0",
    "@fastify/http-proxy": "^11.6.5",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "easyarr": "./dist/index.js"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  }
}
